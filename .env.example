# ─────────────────────────────────────────────────────────────────────────────
# Assistant EveryTask Bot — environment configuration
# Copy to .env and fill in. Everything under "Google sync" is optional; the bot
# works fully offline-of-Google and starts syncing the moment you fill it in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# OpenAI API Key — powers transcription, extraction, receipts, summaries
OPENAI_API_KEY=

# Chat model for text work
OPENAI_MODEL=gpt-4o-mini

# Vision model for reading receipt photos. Leave blank to auto-select.
OPENAI_VISION_MODEL=

# ── Storage ──────────────────────────────────────────────────────────────────
# On Railway point this INSIDE the mounted volume, e.g. /data/assistant.db
DATABASE_PATH=data/assistant.db

# Directory where exported files (PDF, iCal) are saved
EXPORTS_DIR=exports

# ── Scheduling / Time ────────────────────────────────────────────────────────
TIMEZONE=Asia/Bangkok

# ── Household / secretary ────────────────────────────────────────────────────
# The two people whose shared life the bot tracks.
HOUSEHOLD_MEMBERS=J,Farid
OWNER_NAME=J
PARTNER_NAME=Farid

# Telegram user id of your partner, so their voice notes are attributed to them
# automatically. Find it by forwarding one of their messages to @userinfobot.
PARTNER_TELEGRAM_ID=

# Default currency for the shared ledger.
DEFAULT_CURRENCY=THB

# Run every voice note through the secretary pipeline automatically.
SECRETARY_AUTO=true

# ── Google sync (optional) ───────────────────────────────────────────────────
# Targets. Calendar id looks like xxxx@group.calendar.google.com; the sheet and
# folder ids are the long strings in their Drive URLs.
JF_CALENDAR_ID=
LEDGER_SHEET_ID=
DRIVE_FOLDER_ID=

# Auth mode 1 — service account (recommended for a server).
# Paste the whole key JSON on one line, or give a path to the key file.
# Then share the calendar, sheet and folder with the service account's email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Auth mode 2 — OAuth refresh token for the Google account that owns them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
