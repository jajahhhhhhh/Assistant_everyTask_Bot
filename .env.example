# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (for NLP processing, summarization, and task extraction)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use (default: gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# SQLite database path (default: data/assistant.db)
DATABASE_PATH=data/assistant.db

# Directory where exported files (PDF, iCal) are saved
EXPORTS_DIR=exports

# Timezone for reminders and calendar events (e.g. UTC, America/New_York)
TIMEZONE=UTC

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── LINE webhook (line_webhook.py) ────────────────────────────────────────────
# Channel secret จาก LINE Developers > Messaging API — ใช้ตรวจ X-Line-Signature
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Channel access token (long-lived) — ใช้ตอบกลับ/push
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE user id ของเจ้าของระบบ — คำสั่ง "งาน:" / "ติด #12" รับเฉพาะจากคนนี้
LINE_OWNER_USER_ID=

# พาธของ webhook (ต้องตรงกับที่ตั้งใน LINE Developers) และพอร์ตของเซิร์ฟเวอร์
LINE_WEBHOOK_PATH=/webhook/line
PORT=8080

# เลิกเชื่อ reply token หลังกี่วินาที (ของจริงตายราว 60 วิ) แล้วถอยไป push
LINE_REPLY_TOKEN_TTL=50

# เวลาที่ยอมให้ตัวคัดแยก intent ใช้ ก่อนถอยไปใช้กฎ
LINE_CLASSIFY_BUDGET=20

# 1 = บันทึกข้อความตอบรับอัตโนมัติของบอทลง chat_messages ด้วย
# ค่าเริ่มต้นคือ 0 เพราะแถว direction='out' ทุกแถวจะถูก v_reply_latency นับว่า
# "คุณตอบแล้ว" ทำให้ v_unanswered_now ว่างเปล่าทั้งที่ยังไม่มีใครตอบจริง
LINE_LOG_BOT_ACKS=0
